# Copy to .env.local and fill in.
#
# ---------------------------------------------------------------------------
# SECURITY WARNING — read before you fill this in.
#
# Never give these variables a NEXT_PUBLIC_ prefix. Anything prefixed that
# way is inlined into the JavaScript bundle and is therefore readable by
# anyone who opens the page. The service-role key below bypasses row-level
# security entirely; if it leaks, an attacker can read and rewrite the
# whole vault directly through the Supabase REST API, bypassing this app.
# ---------------------------------------------------------------------------

# From your Supabase project settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co

# The "service_role" key -- NOT the anon/publishable key. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key