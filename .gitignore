# environment -- never commit real secrets.
# .env.local holds SUPABASE_SERVICE_ROLE_KEY, which bypasses row-level
# security. Leaking it to a public repo would hand an attacker the whole
# vault. .env.example is the tracked template.
.env
.env*.local

